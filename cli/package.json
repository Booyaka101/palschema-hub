{
  "name": "palschema-validate",
  "version": "0.2.1",
  "description": "Validate Palworld PalSchema mod JSON/JSONC files against the palschema-hub schema registry, and scan them for fields removed/renamed between game versions (--migrate).",
  "keywords": [
    "palworld",
    "palschema",
    "ue4ss",
    "modding",
    "json-schema",
    "validate",
    "migrate",
    "version-diff",
    "ajv"
  ],
  "license": "MIT",
  "author": "Booyaka101",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Booyaka101/palschema-hub.git",
    "directory": "cli"
  },
  "homepage": "https://booyaka101.github.io/palschema-hub/",
  "bugs": "https://github.com/Booyaka101/palschema-hub/issues",
  "type": "commonjs",
  "bin": {
    "palschema-validate": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p .",
    "prepublishOnly": "tsc -p ."
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
