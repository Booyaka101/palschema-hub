      "DT_FieldLotteryNameDataTable": {
        "rowStruct": "FPalFieldLotteryName",
        "fields": 16,
        "rows": 0,
        "source": "sdk-headers-only",
        "note": {
          "text": "One row per lottery name, holding nothing but the chance each of the 15 slots rolls at all. The slot contents are in DT_ItemLotteryDataTable, joined by its FieldName column rather than by row key. Field drops and treasure boxes read these rows, and so do lottery buildings: the Ancient Relic Recycler has no DT_ItemRecipeDataTable rows at all, it maps each input relic to a lottery name (AncientRelicRecycler_WorldTreeRelic_01…_05) through UPalMapObjectRecyclerParameterComponent.RelicItemSettings on its blueprint. That map is blueprint data, so which relic feeds which lottery, and how long it takes, is out of PalSchema's reach — the two lottery tables are not.",
          "source": "SDK headers localcc/PalworldModdingKit@62fad41: PalMapObjectRecyclerParameterComponent.h, PalRecyclerRelicItemSetting.h, PalFieldLotteryName.h.",
          "see": "https://github.com/Booyaka101/palschema-hub#lottery-buildings-the-ancient-relic-recycler"
        }
      },
      "DT_ItemDataTable": {
